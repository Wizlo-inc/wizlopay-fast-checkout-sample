# PostgreSQL connection string
# Example: postgresql://username:password@localhost:5432/checkout_db
DATABASE_URL=postgresql://postgres:password@localhost:5432/checkout_db

# gr4vy credentials — get these from your gr4vy Dashboard
GR4VY_ID=your-gr4vy-id
GR4VY_ENVIRONMENT=sandbox

# Your gr4vy private key (PEM format — paste the full contents, use \n for newlines in .env)
# Alternatively, set GR4VY_PRIVATE_KEY_FILE=./private_key.pem
GR4VY_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----"

# Webhook signing secret — copy from gr4vy Dashboard → Webhooks
GR4VY_WEBHOOK_SECRET=your-webhook-secret

# Port for the Express server
PORT=4000

# Only needed if your gr4vy instance has multiple merchant accounts
# GR4VY_MERCHANT_ACCOUNT_ID=merchant-xxxxxxxx

# Optional: public base URL for redirect / 3DS return URLs (defaults to the request host, e.g. your ngrok URL)
# APP_URL=https://your-subdomain.ngrok-free.dev

# Optional: domain sent for Apple Pay merchant validation (defaults to the request hostname)
# APPLE_PAY_DOMAIN=your-subdomain.ngrok-free.dev
